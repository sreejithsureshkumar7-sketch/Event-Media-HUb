rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }
    function member(eventId) {
      return signedIn() && exists(/databases/$(database)/documents/event_members/$(eventId + '_' + request.auth.uid));
    }

    match /profiles/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && uid == request.auth.uid;
      allow update: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin() || (signedIn() && resource.data.created_by == request.auth.uid);
    }

    match /event_members/{memberId} {
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || isAdmin() || member(resource.data.event_id));
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if signedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow delete: if signedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    match /media/{mediaId} {
      allow read: if signedIn() && (member(resource.data.event_id) || isAdmin() || resource.data.uploaded_by == request.auth.uid);
      allow create: if signedIn() && member(request.resource.data.event_id) && request.resource.data.uploaded_by == request.auth.uid;
      allow update: if signedIn() && (resource.data.uploaded_by == request.auth.uid || isAdmin());
      allow delete: if signedIn() && (resource.data.uploaded_by == request.auth.uid || isAdmin());
    }
  }
}
